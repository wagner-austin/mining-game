--!strict
-- AmbientDebug.client.lua
-- Debug script to verify ambient sound system is working
-- Shows exactly what's happening at each step

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local SoundService = game:GetService("SoundService")

-- Only run in Studio
if not RunService:IsStudio() then
    script:Destroy()
    return
end

local LocalPlayer = Players.LocalPlayer
local MiningGame = ReplicatedStorage:WaitForChild("MiningGame")
local SoundManager = require(MiningGame:WaitForChild("SoundManager"))
local SoundConfig = require(MiningGame:WaitForChild("SoundConfig"))
local AmbientController = require(MiningGame:WaitForChild("AmbientController"))

-- Wait for character
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
task.wait(2)

-- Create debug GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AmbientDebugPanel"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 400, 0, 600)
Frame.Position = UDim2.new(0, 10, 0.5, -300)
Frame.BackgroundColor3 = Color3.new(0, 0, 0)
Frame.BackgroundTransparency = 0.2
Frame.BorderSizePixel = 0
Frame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundColor3 = Color3.new(0.1, 0.1, 0.2)
Title.Text = "🔊 AMBIENT SOUND DEBUG"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.TextScaled = true
Title.Font = Enum.Font.SourceSansBold
Title.Parent = Frame

local ScrollFrame = Instance.new("ScrollingFrame")
ScrollFrame.Size = UDim2.new(1, -10, 1, -35)
ScrollFrame.Position = UDim2.new(0, 5, 0, 35)
ScrollFrame.BackgroundTransparency = 1
ScrollFrame.ScrollBarThickness = 6
ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 1000)
ScrollFrame.Parent = Frame

local DebugText = Instance.new("TextLabel")
DebugText.Size = UDim2.new(1, 0, 1, 0)
DebugText.BackgroundTransparency = 1
DebugText.Text = "Initializing..."
DebugText.TextColor3 = Color3.new(0.9, 0.9, 0.9)
DebugText.TextScaled = false
DebugText.TextSize = 12
DebugText.TextXAlignment = Enum.TextXAlignment.Left
DebugText.TextYAlignment = Enum.TextYAlignment.Top
DebugText.Font = Enum.Font.Code
DebugText.RichText = true
DebugText.Parent = ScrollFrame

-- Test functions
local function getActiveSounds()
    local sounds = {}
    for _, sound in ipairs(SoundService:GetDescendants()) do
        if sound:IsA("Sound") and sound.IsPlaying then
            table.insert(sounds, {
                name = sound.Name,
                id = sound.SoundId,
                volume = sound.Volume,
                parent = sound.Parent and sound.Parent.Name or "nil",
                looped = sound.Looped,
            })
        end
    end
    return sounds
end

local function getZonesInRange()
    local playerPos = Character:GetPivot().Position
    local zones = {}
    
    for _, part in ipairs(CollectionService:GetTagged("AmbientZone")) do
        if part:IsA("BasePart") then
            local soundKey = part:GetAttribute("SoundKey")
            local radius = part:GetAttribute("Radius") or 40
            local priority = part:GetAttribute("Priority") or 0
            local baseVolume = part:GetAttribute("BaseVolume") or 0.35
            
            local distance = (playerPos - part.Position).Magnitude
            local inRange = distance <= radius
            
            -- Calculate volume with same formula as AmbientController
            local falloff = 1 - (distance / radius) * 0.7
            local effectiveVolume = inRange and (baseVolume * falloff) or 0
            
            table.insert(zones, {
                key = soundKey,
                distance = math.floor(distance),
                radius = radius,
                priority = priority,
                baseVolume = baseVolume,
                effectiveVolume = math.max(0, effectiveVolume),
                inRange = inRange,
            })
        end
    end
    
    -- Sort by priority then volume
    table.sort(zones, function(a, b)
        if a.priority ~= b.priority then
            return a.priority > b.priority
        end
        return a.effectiveVolume > b.effectiveVolume
    end)
    
    return zones
end

local function checkSoundConfigs()
    local configs = {}
    
    -- Check if ambient sounds have IDs
    for key, id in pairs(SoundConfig.SoundIDs.ambient) do
        configs[key] = {
            hasId = id ~= nil,
            id = id or "NIL",
            valid = SoundConfig.ValidateSoundID(id)
        }
    end
    
    return configs
end

-- Manual test buttons
local function createButton(text: string, callback: () -> ())
    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0.5, -5, 0, 30)
    Button.BackgroundColor3 = Color3.new(0.2, 0.2, 0.3)
    Button.Text = text
    Button.TextColor3 = Color3.new(1, 1, 1)
    Button.TextScaled = true
    Button.Font = Enum.Font.SourceSans
    Button.Parent = Frame
    
    Button.MouseButton1Click:Connect(callback)
    return Button
end

local TestButton1 = createButton("Test Play Water", function()
    print("[Debug] Manually playing waterflow...")
    local sound = SoundManager.PlayAmbient("waterflow", { volume = 0.8 })
    print("[Debug] Result:", sound)
end)
TestButton1.Position = UDim2.new(0, 5, 1, -35)

local TestButton2 = createButton("Test Stop Water", function()
    print("[Debug] Manually stopping waterflow...")
    SoundManager.StopAmbient("waterflow", false)
end)
TestButton2.Position = UDim2.new(0.5, 0, 1, -35)

-- Update loop
local updateCount = 0
RunService.Heartbeat:Connect(function()
    updateCount = updateCount + 1
    if updateCount % 6 ~= 0 then return end -- Update ~10 times per second
    
    local lines = {}
    
    -- Header
    table.insert(lines, "<b>═══ AMBIENT SOUND DEBUG ═══</b>")
    table.insert(lines, string.format("Time: %.1f | Frame: %d", workspace.DistributedGameTime, updateCount))
    table.insert(lines, "")
    
    -- Sound configs
    table.insert(lines, "<b>▶ SOUND CONFIGS:</b>")
    local configs = checkSoundConfigs()
    for key, info in pairs(configs) do
        local status = info.valid and "✅" or "❌"
        table.insert(lines, string.format("  %s %s: %s", status, key, info.id))
    end
    table.insert(lines, "")
    
    -- Settings
    table.insert(lines, "<b>▶ SETTINGS:</b>")
    table.insert(lines, string.format("  MaxConcurrent: %d", SoundConfig.AmbientSettings.MaxConcurrent or 2))
    table.insert(lines, string.format("  Ambient Volume: %.2f", SoundConfig.Properties.Ambient.Volume))
    table.insert(lines, string.format("  Master Volume: %.2f", SoundManager.GetMasterVolume()))
    table.insert(lines, string.format("  Ambient Group: %.2f", SoundManager.GetGroupVolume("Ambient")))
    table.insert(lines, "")
    
    -- Zones in range
    table.insert(lines, "<b>▶ ZONES DETECTED:</b>")
    local zones = getZonesInRange()
    local inRangeCount = 0
    for i, zone in ipairs(zones) do
        if zone.inRange then
            inRangeCount = inRangeCount + 1
            local marker = i <= 2 and "🎯" or "⏸️"
            table.insert(lines, string.format("  %s [P%d] %s", marker, zone.priority, zone.key))
            table.insert(lines, string.format("     Dist: %d/%d | Vol: %.3f (base %.2f)", 
                zone.distance, zone.radius, zone.effectiveVolume, zone.baseVolume))
        end
    end
    if inRangeCount == 0 then
        table.insert(lines, "  None in range")
    end
    table.insert(lines, "")
    
    -- Active sounds
    table.insert(lines, "<b>▶ PLAYING SOUNDS:</b>")
    local sounds = getActiveSounds()
    local ambientCount = 0
    for _, sound in ipairs(sounds) do
        if sound.parent == "SoundService" or string.find(sound.name:lower(), "ambient") then
            ambientCount = ambientCount + 1
            table.insert(lines, string.format("  🔊 %s", sound.name))
            table.insert(lines, string.format("     Vol: %.3f | Loop: %s", 
                sound.volume, tostring(sound.looped)))
        end
    end
    if ambientCount == 0 then
        table.insert(lines, "  ❌ No ambient sounds playing!")
    end
    table.insert(lines, "")
    
    -- Controller state
    table.insert(lines, "<b>▶ CONTROLLER STATE:</b>")
    local controllerActive = AmbientController and true or false
    table.insert(lines, string.format("  Module loaded: %s", tostring(controllerActive)))
    
    -- Active ambient sounds from SoundManager perspective
    table.insert(lines, "")
    table.insert(lines, "<b>▶ SOUNDMANAGER AMBIENT TRACKING:</b>")
    local activeAmbients = SoundManager.GetActiveAmbient()
    if #activeAmbients > 0 then
        for _, key in ipairs(activeAmbients) do
            table.insert(lines, string.format("  • %s", key))
        end
    else
        table.insert(lines, "  None tracked")
    end
    
    DebugText.Text = table.concat(lines, "\n")
end)

print([[
╔════════════════════════════════════════════╗
║      AMBIENT DEBUG PANEL ACTIVE           ║
╠════════════════════════════════════════════╣
║ • Shows all sound configs and states      ║
║ • Updates 10x per second                  ║
║ • Manual test buttons at bottom           ║
║ • Check left panel for details            ║
╚════════════════════════════════════════════╝
]])