--!strict
-- AmbientZoneTest.client.lua
-- Creates test ambient zones in the generated world for testing
-- DISABLE IN PRODUCTION!

local RunService = game:GetService("RunService")
local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")

-- Only run in Studio
if not RunService:IsStudio() then
    script:Destroy()
    return
end

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

-- ═══════════════════════════════════════════════════
-- TUNABLE VISUALIZATION SETTINGS
-- ═══════════════════════════════════════════════════
local SHOW_ZONES = true               -- Show dome/sphere zones
local ZONE_TRANSPARENCY = 0.85        -- 0 = opaque, 1 = invisible
local ZONE_MATERIAL = Enum.Material.ForceField  -- ForceField, Glass, Neon, SmoothPlastic
local SHOW_BILLBOARDS = true          -- Show info labels above zones
-- ═══════════════════════════════════════════════════

-- Wait a bit for world to load
task.wait(3)

-- Helper to create an invisible ambient zone with optional visualization
local function createZone(position: Vector3, soundKey: string, radius: number, priority: number, volume: number)
    local part = Instance.new("Part")
    part.Name = "AmbientZone_" .. soundKey
    part.Anchored = true
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.Transparency = 1
    part.Size = Vector3.new(4, 4, 4)
    part.Position = position
    part.Parent = workspace
    
    -- Set attributes for the AmbientController
    part:SetAttribute("SoundKey", soundKey)
    part:SetAttribute("Radius", radius)
    part:SetAttribute("Priority", priority)
    part:SetAttribute("BaseVolume", volume)
    
    -- Tag it for the system to pick up
    CollectionService:AddTag(part, "AmbientZone")
    
    -- Visual indicator for testing
    if RunService:IsStudio() then
        -- Billboard for info (if enabled)
        if SHOW_BILLBOARDS then
            local billboard = Instance.new("BillboardGui")
            billboard.Size = UDim2.new(0, 200, 0, 50)
            billboard.StudsOffset = Vector3.new(0, 5, 0)
            billboard.AlwaysOnTop = true
            billboard.Parent = part
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 1, 0)
            label.BackgroundTransparency = 0.3
            label.BackgroundColor3 = Color3.new(0, 0, 0)
            label.Text = string.format("🔊 %s\nR:%d P:%d V:%.2f", soundKey, radius, priority, volume)
            label.TextColor3 = Color3.new(1, 1, 1)
            label.TextScaled = true
            label.Parent = billboard
        end
        
        if SHOW_ZONES then
            -- Create dome/sphere visualization
            local wireframePart = Instance.new("Part")
            wireframePart.Name = "ZoneWireframe"
            wireframePart.Anchored = true
            wireframePart.CanCollide = false
            wireframePart.CanQuery = false
            wireframePart.CanTouch = false
            wireframePart.Shape = Enum.PartType.Ball
            wireframePart.Material = ZONE_MATERIAL
            wireframePart.Size = Vector3.new(radius * 2, radius * 2, radius * 2)
            wireframePart.Position = position
            wireframePart.Transparency = ZONE_TRANSPARENCY
            wireframePart.Parent = workspace
            
            -- Color code by sound type
            local colors = {
                waterflow = Color3.new(0, 0.5, 1),      -- Blue
                lavaflow = Color3.new(1, 0.3, 0),       -- Orange/Red
                wind = Color3.new(0.7, 0.7, 0.7),       -- Gray
                birds_morning = Color3.new(1, 1, 0.3),  -- Yellow
                icecracking = Color3.new(0.5, 0.8, 1),  -- Light Blue
                crickets = Color3.new(0.2, 0.4, 0.2),   -- Dark Green
                trees_rustling = Color3.new(0.3, 0.6, 0.3), -- Green
            }
            wireframePart.Color = colors[soundKey] or Color3.new(0.5, 0.5, 0.5)
        end
    end
    
    return part
end

-- Inject test sounds into SoundConfig before creating zones
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MiningGame = ReplicatedStorage:WaitForChild("MiningGame")
local SoundConfig = require(MiningGame:WaitForChild("SoundConfig"))

-- Use Roblox default test sounds
local TEST_AMBIENT_SOUND = "rbxassetid://9120386436" -- Click sound for testing
local TEST_MUSIC_SOUND = "rbxassetid://1837879082" -- Carefree music

-- Inject test sounds for ambient categories
SoundConfig.SoundIDs.ambient.waterflow = TEST_MUSIC_SOUND
SoundConfig.SoundIDs.ambient.lavaflow = TEST_AMBIENT_SOUND
SoundConfig.SoundIDs.ambient.wind = TEST_MUSIC_SOUND
SoundConfig.SoundIDs.ambient.birds_morning = TEST_AMBIENT_SOUND
SoundConfig.SoundIDs.ambient.icecracking = TEST_AMBIENT_SOUND

-- The click sound is much quieter than the music, so let's boost the default Ambient volume
-- This is temporary - when you add real sounds, you can normalize them in the audio files
local originalAmbientVolume = SoundConfig.Properties.Ambient.Volume
SoundConfig.Properties.Ambient.Volume = 1.0  -- Boost from 0.6 to 1.0 for testing

print("[AmbientZoneTest] Injected test sounds into ambient categories")

-- Create test zones around spawn (avoiding the cube in front)
local spawnPos = Character:GetPivot().Position
-- Cube spawns at approximately spawnPos + Vector3.new(0, 0, -64) with 32 stud radius

-- Water zone to the far left (safe from cube)
createZone(
    spawnPos + Vector3.new(-120, 0, 0),
    "waterflow",
    60,  -- radius
    2,   -- priority
    0.5  -- volume (boosted from 0.35)
)

-- Lava zone to the far right (safe from cube) 
-- The click sound is VERY quiet, needs major boost
createZone(
    spawnPos + Vector3.new(120, 0, 0),
    "lavaflow",
    50,
    3,   -- higher priority than water
    1.0  -- MAX volume (was 0.4) - click sound is super quiet
)

-- Wind zone above/around (lower priority, larger, won't interfere)
createZone(
    spawnPos + Vector3.new(0, 30, 0),
    "wind",
    100, -- large radius
    1,   -- low priority
    0.4  -- volume (boosted from 0.2)
)

-- Birds zone BEHIND player (cube is in front)
createZone(
    spawnPos + Vector3.new(0, 10, 80),
    "birds_morning",
    50,
    0,   -- lowest priority
    1.0  -- MAX volume (was 0.25) - click sound needs it
)

-- Ice cracking diagonal back-left
createZone(
    spawnPos + Vector3.new(-80, 0, 60),
    "icecracking",
    45,
    2,
    1.0  -- MAX volume (was 0.3) - click sound is barely audible otherwise
)

-- Create debug GUI to show current zones
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "AmbientZoneDebug"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local Frame = Instance.new("Frame")
Frame.Size = UDim2.new(0, 250, 0, 200)
Frame.Position = UDim2.new(1, -260, 0, 10)
Frame.BackgroundColor3 = Color3.new(0, 0, 0)
Frame.BackgroundTransparency = 0.3
Frame.BorderSizePixel = 0
Frame.Parent = ScreenGui

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 30)
Title.BackgroundTransparency = 1
Title.Text = "🔊 AMBIENT ZONES"
Title.TextColor3 = Color3.new(1, 1, 1)
Title.TextScaled = true
Title.Font = Enum.Font.SourceSansBold
Title.Parent = Frame

local ZoneList = Instance.new("TextLabel")
ZoneList.Size = UDim2.new(1, -10, 1, -35)
ZoneList.Position = UDim2.new(0, 5, 0, 35)
ZoneList.BackgroundTransparency = 1
ZoneList.Text = "No zones detected"
ZoneList.TextColor3 = Color3.new(0.9, 0.9, 0.9)
ZoneList.TextScaled = false
ZoneList.TextSize = 14
ZoneList.TextXAlignment = Enum.TextXAlignment.Left
ZoneList.TextYAlignment = Enum.TextYAlignment.Top
ZoneList.Font = Enum.Font.SourceSans
ZoneList.Parent = Frame

-- Update loop to show which zones player is in
RunService.Heartbeat:Connect(function()
    local playerPos = Character:GetPivot().Position
    local inZones = {}
    
    for _, part in ipairs(CollectionService:GetTagged("AmbientZone")) do
        if part:IsA("BasePart") then
            local soundKey = part:GetAttribute("SoundKey")
            local radius = part:GetAttribute("Radius") or 40
            local priority = part:GetAttribute("Priority") or 0
            local volume = part:GetAttribute("BaseVolume") or 0.35
            
            local distance = (playerPos - part.Position).Magnitude
            if distance <= radius then
                local effectiveVolume = volume * (1 - distance / radius)
                table.insert(inZones, {
                    key = soundKey,
                    distance = math.floor(distance),
                    radius = radius,
                    priority = priority,
                    volume = effectiveVolume,
                })
            end
        end
    end
    
    -- Sort by priority then volume
    table.sort(inZones, function(a, b)
        if a.priority ~= b.priority then
            return a.priority > b.priority
        end
        return a.volume > b.volume
    end)
    
    -- Format display
    if #inZones > 0 then
        local lines = {"INSIDE ZONES:"}
        for i, zone in ipairs(inZones) do
            local status = i <= 2 and "🔊 PLAYING" or "⏸️ QUEUED"
            table.insert(lines, string.format(
                "%s %s\n  Dist: %d/%d | Pri: %d | Vol: %.2f",
                status,
                zone.key:upper(),
                zone.distance,
                zone.radius,
                zone.priority,
                zone.volume
            ))
        end
        ZoneList.Text = table.concat(lines, "\n\n")
    else
        ZoneList.Text = "No zones in range\n\nWalk towards a billboard!"
    end
end)

print([[
