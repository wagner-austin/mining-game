--!strict
-- MaterialManagerClient.client.lua
-- Client-side initialization for material themes

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local localPlayer = Players.LocalPlayer

-- Wait for shared modules
local MiningGame = ReplicatedStorage:WaitForChild("MiningGame", 10)
if not MiningGame then
    warn("[MaterialManagerClient] MiningGame folder not found")
    return
end

local MaterialManager = require(MiningGame:WaitForChild("MaterialManager"))
local MaterialPalettes = require(MiningGame:WaitForChild("MaterialPalettes"))
local MaterialKeys = require(MiningGame:WaitForChild("MaterialKeys"))
local Remotes = require(MiningGame:WaitForChild("Remotes"))

-- Helper function to get display names
local function getDisplayName(key: string): string
    return MaterialKeys.DisplayNames[key] or key
end

-- Debug UI for testing palettes and materials
local function createDebugUI()
    local player = game.Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "MaterialDebugUI"
    screenGui.ResetOnSpawn = false
    screenGui.Enabled = false  -- Start closed by default
    screenGui.Parent = playerGui
    
    -- Container frame (bottom left)
    local frame = Instance.new("Frame")
    frame.Name = "MaterialControls"
    frame.Size = UDim2.new(0, 200, 0, 300)
    frame.Position = UDim2.new(0, 10, 1, -310)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    frame.BorderSizePixel = 0
    frame.Parent = screenGui
    
    -- Title
    local title = Instance.new("TextLabel")
    title.Text = "Material Manager"
    title.Size = UDim2.new(1, 0, 0, 30)
    title.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextScaled = true
    title.Font = Enum.Font.SourceSansBold
    title.BorderSizePixel = 0
    title.Parent = frame
    
    -- Palette section
    local paletteLabel = Instance.new("TextLabel")
    paletteLabel.Text = "Palette Theme:"
    paletteLabel.Size = UDim2.new(1, -10, 0, 20)
    paletteLabel.Position = UDim2.new(0, 5, 0, 35)
    paletteLabel.BackgroundTransparency = 1
    paletteLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    paletteLabel.TextScaled = true
    paletteLabel.TextXAlignment = Enum.TextXAlignment.Left
    paletteLabel.Font = Enum.Font.SourceSans
    paletteLabel.Parent = frame
    
    -- Palette dropdown (simplified - just cycle button)
    local paletteButton = Instance.new("TextButton")
    paletteButton.Text = "default"
    paletteButton.Size = UDim2.new(1, -10, 0, 25)
    paletteButton.Position = UDim2.new(0, 5, 0, 55)
    paletteButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    paletteButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    paletteButton.TextScaled = true
    paletteButton.Font = Enum.Font.SourceSans
    paletteButton.BorderSizePixel = 0
    paletteButton.Parent = frame
    
    local paletteNames = MaterialPalettes.GetPaletteNames()
    local currentPaletteIndex = 1
    
    paletteButton.MouseButton1Click:Connect(function()
        currentPaletteIndex = currentPaletteIndex % #paletteNames + 1
        local paletteName = paletteNames[currentPaletteIndex]
        paletteButton.Text = paletteName
        MaterialManager.SetPalette(paletteName)
        print("[MaterialManagerClient] Changed palette to:", paletteName)
    end)
    
    -- Cube Material section
    local cubeLabel = Instance.new("TextLabel")
    cubeLabel.Text = "Cube Material:"
    cubeLabel.Size = UDim2.new(1, -10, 0, 20)
    cubeLabel.Position = UDim2.new(0, 5, 0, 90)
    cubeLabel.BackgroundTransparency = 1
    cubeLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    cubeLabel.TextScaled = true
    cubeLabel.TextXAlignment = Enum.TextXAlignment.Left
    cubeLabel.Font = Enum.Font.SourceSans
    cubeLabel.Parent = frame
    
    local cubeButton = Instance.new("TextButton")
    cubeButton.Text = "stone"
    cubeButton.Size = UDim2.new(1, -10, 0, 25)
    cubeButton.Position = UDim2.new(0, 5, 0, 110)
    cubeButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    cubeButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    cubeButton.TextScaled = true
    cubeButton.Font = Enum.Font.SourceSans
    cubeButton.BorderSizePixel = 0
    cubeButton.Parent = frame
    
    -- Cube materials from shared module
    local cubeKeys = MaterialKeys.CubeMaterials
    local currentCubeIndex = 1
    cubeButton.Text = getDisplayName(cubeKeys[currentCubeIndex])
    
    cubeButton.MouseButton1Click:Connect(function()
        currentCubeIndex = currentCubeIndex % #cubeKeys + 1
        local key = cubeKeys[currentCubeIndex]
        cubeButton.Text = getDisplayName(key)
        
        -- Update visual system (for future part-based cubes)
        MaterialManager.SetCubeMaterial(key)
        
        -- Call server to repaint terrain
        pcall(function()
            local success = Remotes.RF.ApplyCubeSurfaceMaterial:InvokeServer(key)
            if success then
                print("[MaterialManagerClient] Changed cube terrain to:", key)
            else
                warn("[MaterialManagerClient] Failed to change cube terrain")
            end
        end)
    end)
    
    -- Floor Material section
    local floorLabel = Instance.new("TextLabel")
    floorLabel.Text = "Floor Material:"
    floorLabel.Size = UDim2.new(1, -10, 0, 20)
    floorLabel.Position = UDim2.new(0, 5, 0, 145)
    floorLabel.BackgroundTransparency = 1
    floorLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
    floorLabel.TextScaled = true
    floorLabel.TextXAlignment = Enum.TextXAlignment.Left
    floorLabel.Font = Enum.Font.SourceSans
    floorLabel.Parent = frame
    
    local floorButton = Instance.new("TextButton")
    floorButton.Text = "Concrete"
    floorButton.Size = UDim2.new(1, -10, 0, 25)
    floorButton.Position = UDim2.new(0, 5, 0, 165)
    floorButton.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
    floorButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    floorButton.TextScaled = true
    floorButton.Font = Enum.Font.SourceSans
    floorButton.BorderSizePixel = 0
    floorButton.Parent = frame
    
    -- Floor materials from shared module (TitleCase keys)
    local floorKeys = MaterialKeys.FloorMaterials
    local currentFloorIndex = 1
    floorButton.Text = getDisplayName(floorKeys[currentFloorIndex])
    
    floorButton.MouseButton1Click:Connect(function()
        currentFloorIndex = currentFloorIndex % #floorKeys + 1
        local key = floorKeys[currentFloorIndex]
        floorButton.Text = getDisplayName(key)
        
        -- Visual system update removed (floor is terrain, handled by server)
        
        -- Call server to repaint terrain under neon bars
        pcall(function()
            local success = Remotes.RF.ApplyFloorMaterial:InvokeServer(key)
            if success then
                print("[MaterialManagerClient] Changed floor terrain to:", key)
            else
                warn("[MaterialManagerClient] Failed to change floor terrain")
            end
        end)
    end)
    
    -- Instructions
    local instructions = Instance.new("TextLabel")
    instructions.Text = "Click buttons to cycle\nthrough options.\n\nPress M to toggle UI"
    instructions.Size = UDim2.new(1, -10, 0, 60)
    instructions.Position = UDim2.new(0, 5, 0, 200)
    instructions.BackgroundTransparency = 1
    instructions.TextColor3 = Color3.fromRGB(150, 150, 150)
    instructions.TextScaled = true
    instructions.Font = Enum.Font.SourceSans
    instructions.Parent = frame
    
    -- Toggle visibility with M key
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.M then
            screenGui.Enabled = not screenGui.Enabled
        end
    end)
    
    print("[MaterialManagerClient] Debug UI created - Press M to toggle")
end

-- Helper to find the local player's specific MiningCube
local function findMyMiningCube()
    local expected = ("MiningCube_%d"):format(localPlayer.UserId)
    
    -- Try direct child first (most common case)
    local cube = workspace:FindFirstChild(expected)
    if cube then return cube end
    
    -- Fallback: recursive search in case of future nesting
    cube = workspace:FindFirstChild(expected, true)
    if cube then return cube end
    
    -- Last resort for studio testing: find closest MiningCube_*
    local char = localPlayer.Character or localPlayer.CharacterAdded:Wait()
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local best, bestDist = nil, math.huge
    
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("Model") and inst.Name:match("^MiningCube_%d+$") then
            local pos = inst:GetPivot().Position
            local dist = hrp and (pos - hrp.Position).Magnitude or math.huge
            if dist < bestDist then
                bestDist = dist
                best = inst
            end
        end
    end
    
    return best
end

-- Tag the cube parts for the material system
local function tagCubeParts()
    local cube = findMyMiningCube()
    if not cube then
        warn("[MaterialManagerClient] My MiningCube not found - will retry...")
        return false
    end
    
    print("[MaterialManagerClient] Found my MiningCube at", cube:GetFullName())
    
    -- Tag all cube parts
    local tagged = 0
    for _, descendant in ipairs(cube:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Name:match("Cell") then
            CollectionService:AddTag(descendant, "CubeBlock")
            tagged = tagged + 1
        end
    end
    
    -- Tag floor glow indicators
    local indicators = cube:FindFirstChild("Indicators")
    if indicators then
        local glowCount = 0
        
        for _, child in ipairs(indicators:GetChildren()) do
            if child:IsA("BasePart") and child.Material == Enum.Material.Neon then
                CollectionService:AddTag(child, "GlowBar")
                glowCount = glowCount + 1
            end
        end
        
        print("[MaterialManagerClient] Tagged", glowCount, "glow bars in my cube")
        return true -- Success
    else
        warn("[MaterialManagerClient] No Indicators folder found in my MiningCube")
        return false
    end
    
    print("[MaterialManagerClient] Tagged", tagged, "cube parts")
end

-- Initialize
print("[MaterialManagerClient] Starting...")

-- Initialize the MaterialManager
MaterialManager.Initialize()
print("[MaterialManagerClient] MaterialManager initialized")

-- Tag existing parts (retry until found)
task.spawn(function()
    local attempts = 0
    local maxAttempts = 10
    
    while attempts < maxAttempts do
        attempts = attempts + 1
        task.wait(1) -- Wait between attempts
        
        if tagCubeParts() then
            print("[MaterialManagerClient] Successfully tagged my cube parts")
            
            -- Verify tagging worked
            local tagged = CollectionService:GetTagged("GlowBar")
            print("[MaterialManagerClient] Total GlowBars tagged:", #tagged)
            break
        end
    end
    
    -- Also listen for my cube if it appears later
    workspace.ChildAdded:Connect(function(child)
        local expectedName = ("MiningCube_%d"):format(localPlayer.UserId)
        if child.Name == expectedName then
            print("[MaterialManagerClient] My MiningCube appeared:", child.Name)
            task.wait(0.5)
            tagCubeParts()
        end
    end)
end)

-- Create debug UI
createDebugUI()

print("[MaterialManagerClient] Ready! Press M to toggle material controls")