--!strict
-- PerformanceMonitor.client.lua
-- Shows FPS, memory usage, and performance stats

local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("MiningGame")
local Time = require(Shared:WaitForChild("Time"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Create UI
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "PerformanceMonitor"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 10
screenGui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 150)
frame.Position = UDim2.new(1, -210, 0, 10)
frame.BackgroundColor3 = Color3.new(0, 0, 0)
frame.BackgroundTransparency = 0.3
frame.BorderSizePixel = 0
frame.Parent = screenGui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 20)
title.BackgroundTransparency = 1
title.Text = "PERFORMANCE"
title.TextColor3 = Color3.new(1, 1, 1)
title.TextSize = 14
title.Font = Enum.Font.SourceSansBold
title.Parent = frame

local statsLabel = Instance.new("TextLabel")
statsLabel.Size = UDim2.new(1, -10, 1, -25)
statsLabel.Position = UDim2.new(0, 5, 0, 25)
statsLabel.BackgroundTransparency = 1
statsLabel.TextColor3 = Color3.new(1, 1, 1)
statsLabel.TextSize = 12
statsLabel.TextXAlignment = Enum.TextXAlignment.Left
statsLabel.TextYAlignment = Enum.TextYAlignment.Top
statsLabel.Font = Enum.Font.Code
statsLabel.Text = "Loading..."
statsLabel.Parent = frame

-- Performance tracking
local frameCount = 0
local lastUpdate = Time.mono()
local fps = 0

-- Event-based counters (no scanning)
local partCount, scriptCount = 0, 0

local function tally(inst: Instance, delta: number)
    if inst:IsA("BasePart") then
        partCount = partCount + delta
    elseif inst:IsA("Script") or inst:IsA("LocalScript") or inst:IsA("ModuleScript") then
        scriptCount = scriptCount + delta
    end
end

-- Initial count (one-time only)
for _, v in ipairs(workspace:GetDescendants()) do
    tally(v, 1)
end

-- Track changes via events
workspace.DescendantAdded:Connect(function(v) tally(v, 1) end)
workspace.DescendantRemoving:Connect(function(v) tally(v, -1) end)

-- Update loop with safe stats only
local sampleWindow = 0.5

RunService.Heartbeat:Connect(function(dt)
    frameCount = frameCount + 1
    local now = Time.mono()
    
    if now - lastUpdate >= sampleWindow then
        fps = frameCount / (now - lastUpdate)
        frameCount = 0
        lastUpdate = now
        
        -- Safe stats only
        local memMb = Stats:GetTotalMemoryUsageMb()
        
        -- Build display lines
        local lines = {
            string.format("FPS: %.0f", fps),
            string.format("Memory: %.1f MB", memMb),
            "Ping: n/a (Studio)", -- Avoid plugin API
            string.format("Parts: %d", partCount),
            string.format("Scripts: %d", scriptCount),
        }
        
        -- Color code FPS
        if fps < 30 then
            statsLabel.TextColor3 = Color3.new(1, 0.3, 0.3) -- Red
        elseif fps < 50 then
            statsLabel.TextColor3 = Color3.new(1, 1, 0.3) -- Yellow
        else
            statsLabel.TextColor3 = Color3.new(0.3, 1, 0.3) -- Green
        end
        
        statsLabel.Text = table.concat(lines, "\n")
    end
end)

print("[PerformanceMonitor] Active - showing FPS and stats")