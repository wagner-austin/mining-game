--!strict
-- DISABLED: Studio-only ClothSimulator tool client retained for reference
-- Original path: client/ClothToolClient.client.lua

if not game:GetService("RunService"):IsStudio() then return end

-- Client for ClothSimulator tool: Spawns/destroys cloth on equip/unequip
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local MiningGame = RS:WaitForChild("MiningGame")
local Logger = require(MiningGame:WaitForChild("Logger"))
local log = Logger.new("ClothTool")
local Remotes = require(MiningGame:WaitForChild("Remotes"))
local RF = Remotes.RF

local function attachTool(tool: Tool)
    if tool.Name ~= "ClothSimulator" then return end

    tool.Equipped:Connect(function()
        log:info("Equipped; requesting server cloth spawn")
        local res = RF.ClothSpawn:InvokeServer({ span = 12 })
        if res and res.success then
            log:info("Cloth spawned on server")
        else
            log:warn("Cloth spawn failed")
        end
    end)

    tool.Unequipped:Connect(function()
        RF.ClothDestroy:InvokeServer()
        log:debug("Unequipped; destroyed server cloth")
    end)
end

local function scanForTool()
    local backpack = player:WaitForChild("Backpack")
    for _, child in ipairs(backpack:GetChildren()) do
        if child:IsA("Tool") then attachTool(child) end
    end
    if player.Character then
        for _, child in ipairs(player.Character:GetChildren()) do
            if child:IsA("Tool") then attachTool(child) end
        end
    end
end

scanForTool()
player.Backpack.ChildAdded:Connect(function(c)
    if c:IsA("Tool") then attachTool(c) end
end)
player.CharacterAdded:Connect(function()
    task.delay(0.1, scanForTool)
end)

